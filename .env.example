# Database (MySQL)
DB_HOST=localhost
DB_USER=mail_ai
DB_PASS=your_strong_db_password
DB_NAME=ai_mail_bot
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password

# Groq LLM API
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.6-27b

# Redis
REDIS_URL=redis://mail_ai_redis:6379/0
REDIS_HISTORY_URL=redis://mail_ai_redis:6379/1
REDIS_SESSION_URL=redis://mail_ai_redis:6379/2

# Vector Knowledge Base (Qdrant & Embeddings)
QDRANT_HOST=mail_ai_qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=mail_ai_knowledge
EMBED_SERVICE_URL=http://mail_ai_embed_service:8500

# REST API Ingestion Secret (X-API-Key / X-Webhook-Secret for POST /process-email)
INGESTION_API_KEY=your_secure_ingestion_api_key_here

# Encryption Key (Fernet 32-byte base64 key: generate via `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`)
CONNECTOR_SECRET_ENCRYPTION_KEY=your_fernet_key_base64_here

# Outbound System Mailer (Registration & Alerts)
REGISTRATION_EMAIL=
REGISTRATION_EMAIL_PASS=

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:1947,http://172.16.3.215:1947

